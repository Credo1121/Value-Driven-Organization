{
  "name": "value-driven-organization",
  "version": "0.1.0",
  "private": true,
  "description": "The Value Driven Organization – moderated explainer for integrated technology steering (EPM, TBM, LPM, EA)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:content": "vitest run tests/content.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "serve:out": "node scripts/serve-out.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
